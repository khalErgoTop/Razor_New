@page
@model TOPqwWeb_Core.Pages.Auth.SystemNewsModel
@{
    ViewData["Title"] = "Systemnachrichten";
}

<nav class="kern-breadcrumbs" aria-label="Brotkrümelnavigation">
    <ol class="breadcrumb"><li><a class="kern-link" asp-page="/Index">Start</a></li><li><a class="kern-link" asp-page="/Auth/QWWebAdmin">Administration</a></li><li aria-current="page">Nachrichtentexte bearbeiten</li></ol>
</nav>

<section class="pageContent kern-stack">
    <h1 class="kern-heading-1">System-Nachrichten</h1>
    @if (Model.Message is not null)
    {
        <div class="kern-alert kern-alert--success" role="status"><div class="kern-alert__body">@Model.Message</div></div>
    }
    <form method="post" class="kern-card" style="padding:16px">
        <label for="SelectedNewsId">Nachrichten</label>
        <select class="kern-form-input__select" id="SelectedNewsId" name="SelectedNewsId" size="6" onchange="this.form.action='?handler=Select'; this.form.submit();">
            @foreach (var newsItem in Model.News)
            {
                <option value="@newsItem.Id" selected="@(newsItem.Id == Model.SelectedNewsId)">@newsItem.Text (@newsItem.UserCount Benutzer)</option>
            }
        </select>
        <div>
            <button class="kern-button kern-button--primary" type="submit" formaction="?handler=New">Erstellen</button>
            <button class="kern-button kern-button--tertiary" type="submit" asp-page-handler="Delete" onclick="return confirm('Nachricht wirklich löschen?');">Löschen</button>
        </div>
    </form>

    <form method="post" class="kern-card" style="padding:16px">
        <input type="hidden" name="SelectedNewsId" value="@Model.SelectedNewsId" />
        <label for="InfoLabel">Name der Abfrage</label>
        <input class="kern-form-input__input" id="InfoLabel" name="InfoLabel" value="@Model.InfoLabel" />
        <label for="InfoText">Infotext</label>
        <textarea class="kern-form-input__input" id="InfoText" name="InfoText" rows="5">@Model.InfoText</textarea>
        <button class="kern-button kern-button--primary" type="submit" asp-page-handler="Save">Speichern</button>
    </form>

    @if (Model.SelectedNewsId > 0)
    {
        <div class="kern-card" style="padding:16px">
            <h2 class="kern-heading-2">Personen zur ausgewählten Nachricht</h2>
            <form method="post">
                <input type="hidden" name="SelectedNewsId" value="@Model.SelectedNewsId" />
                <select class="kern-form-input__select" name="PersonIds" multiple size="12">
                    @foreach (var person in Model.SelectedPersons)
                    {
                        <option value="@person.Id">@person.Username (@person.UserType)</option>
                    }
                </select>
                <button class="kern-button kern-button--tertiary" type="submit" asp-page-handler="RemovePersons">Abwählen</button>
            </form>
            <h2 class="kern-heading-2">Verfügbare Personen</h2>
            <form method="post">
                <input type="hidden" name="SelectedNewsId" value="@Model.SelectedNewsId" />
                <select class="kern-form-input__select" name="PersonIds" multiple size="12">
                    @foreach (var person in Model.AvailablePersons)
                    {
                        <option value="@person.Id">@person.Username (@person.UserType)</option>
                    }
                </select>
                <button class="kern-button kern-button--primary" type="submit" asp-page-handler="AddPersons">Hinzufügen</button>
            </form>
        </div>
    }
</section>

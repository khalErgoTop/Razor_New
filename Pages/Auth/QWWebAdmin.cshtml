@page
@model TOPqwWeb_Core.Pages.Auth.QWWebAdminModel
@{
    ViewData["Title"] = "Administration";
}

<nav class="kern-breadcrumbs" aria-label="Brotkrümelnavigation">
    <ol class="breadcrumb"><li><a class="kern-link" asp-page="/Index">Start</a></li><li aria-current="page">Administration</li></ol>
</nav>

<section class="pageContent kern-stack">
    <h1 class="kern-heading-1">Administration</h1>
    @if (!string.IsNullOrWhiteSpace(Model.Hint))
    {
        <div class="kern-alert kern-alert--info"><div class="kern-alert__body">@Model.Hint</div></div>
    }
    <ul class="kern-list kern-card" style="padding:16px; list-style:none">
        @foreach (var link in Model.Links)
        {
            <li><a class="kern-button kern-button--secondary" asp-page="@link.Page">@link.Text</a></li>
        }
    </ul>
</section>
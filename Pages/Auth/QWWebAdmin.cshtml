@page
@model TOPqwWeb_Core.Pages.Auth.QWWebAdminModel
@{
    ViewData["Title"] = "Administration";
    ViewData["UseLegacyTheme"] = false;
}

<nav class="kern-breadcrumbs admin-breadcrumbs" aria-label="Brotkrümelnavigation">
    <ol class="breadcrumb">
        <li><a class="kern-link" asp-page="/Index"><span class="kern-icon kern-icon--home" aria-hidden="true"></span> Start</a></li>
        <li aria-current="page">Administration</li>
    </ol>
</nav>

<main class="admin-page kern-stack">
    <header class="admin-page__hero kern-card kern-card--surface">
        <div class="kern-card__container">
            <div class="admin-page__hero-icon kern-badge kern-badge--info" aria-hidden="true">
                <span class="kern-icon kern-icon--more-vert"></span>
            </div>
            <div class="admin-page__hero-copy">
                <p class="admin-page__eyebrow">Arbeitsbereich</p>
                <h1 class="kern-heading-1">Administration</h1>
                <p class="kern-body">Verwalten Sie Benutzer, Einstellungen, Hilfetexte und Systeminformationen zentral an einem Ort.</p>
            </div>
            <span class="kern-badge kern-badge--success"><span class="kern-icon kern-icon--check" aria-hidden="true"></span><span class="kern-label">Verwaltung</span></span>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.Hint))
    {
        <section class="kern-alert kern-alert--info admin-page__hint" role="status" aria-label="Hinweis">
            <span class="kern-icon kern-icon--info" aria-hidden="true"></span>
            <div class="kern-alert__body">
                <strong>Hinweis</strong>
                <span>@Model.Hint</span>
            </div>
        </section>
    }

    @if (Model.Links.Count > 0)
    {
        <section class="admin-page__actions" aria-labelledby="admin-actions-title">
            <div class="admin-page__section-heading">
                <div>
                    <p class="admin-page__eyebrow">Verfügbare Bereiche</p>
                    <h2 id="admin-actions-title" class="kern-title">Was möchten Sie verwalten?</h2>
                </div>
                <span class="kern-badge kern-badge--small kern-badge--info"><span class="kern-label">@Model.Links.Count Bereiche</span></span>
            </div>

            <ul class="admin-action-list kern-list" role="list">
                @foreach (var link in Model.Links)
                {
                    <li class="admin-action-list__item">
                        <a class="admin-action kern-card kern-card--interactive" asp-page="@link.Page">
                            <span class="admin-action__icon kern-badge kern-badge--info" aria-hidden="true">
                                <span class="kern-icon @(link.Text.Contains("Passwort", StringComparison.OrdinalIgnoreCase) ? "kern-icon--visibility-off" : link.Text.Contains("Benutzer", StringComparison.OrdinalIgnoreCase) ? "kern-icon--account-circle" : link.Text.Contains("Fehler", StringComparison.OrdinalIgnoreCase) ? "kern-icon--danger" : link.Text.Contains("Optionen", StringComparison.OrdinalIgnoreCase) ? "kern-icon--more-vert" : "kern-icon--edit")"></span>
                            </span>
                            <span class="admin-action__content">
                                <strong>@link.Text</strong>
                                <span class="kern-body">Bereich öffnen und verwalten</span>
                            </span>
                            <span class="admin-action__arrow kern-icon kern-icon--arrow-forward" aria-hidden="true"></span>
                        </a>
                    </li>
                }
            </ul>
        </section>
    }
    else
    {
        <section class="kern-alert kern-alert--warning" role="status">
            <span class="kern-icon kern-icon--warning" aria-hidden="true"></span>
            <div class="kern-alert__body">Für Ihr Konto sind derzeit keine Administrationsbereiche freigeschaltet.</div>
        </section>
    }
</main>

<style>
    .admin-page { width: min(100%, 980px); margin: 0 auto; padding: 1rem 0 4rem; }
    .admin-breadcrumbs { width: min(100%, 980px); margin-left: auto; margin-right: auto; }
    .admin-page__hero { background: var(--kern-color-layout-background-level-1); }
    .admin-page__hero .kern-card__container { align-items: center; display: flex; gap: 1rem; padding: 2.25rem; }
    .admin-page__hero-icon { align-items: center; display: inline-flex; flex: 0 0 4rem; height: 4rem; justify-content: center; }
    .admin-page__hero-icon .kern-icon { font-size: 2rem; }
    .admin-page__hero-copy { flex: 1; }
    .admin-page__hero h1 { margin: 0 0 .45rem; }
    .admin-page__hero p { margin: 0; max-width: 42rem; }
    .admin-page__hero > .kern-badge { flex-shrink: 0; }
    .admin-page__eyebrow { color: var(--kern-color-action-default-contextual); font-size: .75rem; font-weight: 800; letter-spacing: .08em; margin: 0 0 .35rem; text-transform: uppercase; }
    .admin-page__hint { align-items: flex-start; display: flex; gap: .75rem; margin-top: 1.25rem; }
    .admin-page__hint .kern-alert__body { display: grid; gap: .25rem; }
    .admin-page__actions { margin-top: 2rem; }
    .admin-page__section-heading { align-items: end; display: flex; justify-content: space-between; margin-bottom: 1rem; }
    .admin-page__section-heading h2 { margin: 0; }
    .admin-action-list { display: grid; gap: 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0; padding: 0; }
    .admin-action-list__item { list-style: none; }
    .admin-action { align-items: center; display: flex; gap: 1rem; min-height: 7rem; padding: 1.25rem; text-decoration: none; transition: transform .15s ease, box-shadow .15s ease; }
    .admin-action:hover { transform: translateY(-2px); }
    .admin-action__icon { align-items: center; display: inline-flex; flex: 0 0 3rem; height: 3rem; justify-content: center; }
    .admin-action__icon .kern-icon { font-size: 1.45rem; }
    .admin-action__content { display: grid; gap: .3rem; min-width: 0; }
    .admin-action__content strong { font-size: 1.05rem; }
    .admin-action__content .kern-body { color: var(--kern-color-layout-text-muted); font-size: .9rem; }
    .admin-action__arrow { margin-left: auto; }
    @@media (max-width: 680px) {
        .admin-page__hero .kern-card__container { align-items: flex-start; flex-wrap: wrap; padding: 1.5rem; }
        .admin-page__hero-copy { flex-basis: calc(100% - 5rem); }
        .admin-page__hero > .kern-badge { margin-left: 5rem; }
        .admin-action-list { grid-template-columns: 1fr; }
    }
    @@media (max-width: 430px) {
        .admin-page__hero .kern-card__container { display: grid; }
        .admin-page__hero-copy { grid-row: 2; }
        .admin-page__hero > .kern-badge { margin-left: 0; }
        .admin-page__section-heading { align-items: flex-start; flex-direction: column; gap: .75rem; }
    }
</style>
@page
@model TOPqwWeb_Core.Pages.SuchAssistentModel
@{
    ViewData["Title"] = "Assistierte Suche";
}

<nav aria-label="Brotkrümelnavigation">
    <ol class="breadcrumb">
        <li><a asp-page="/Index">Start</a></li>
        <li aria-current="page">Assistierte Suche</li>
    </ol>
</nav>

<h1>Assistierte Suche</h1>

@if (string.IsNullOrWhiteSpace(Model.Suchtyp))
{
    <div class="kern-card" style="padding:16px; margin-bottom:16px">
        <h2>Wissen Sie, was ein Leistungstyp ist?</h2>
        <p>Wenn Sie nach einem Leistungstyp suchen möchten, wählen Sie „Ja“.</p>
        <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:12px">
            <a class="kern-button kern-button--secondary" asp-page="/Suche">Nein, ich möchte die einfache Suche benutzen</a>
            <a class="kern-button kern-button--primary" asp-page="/SuchAssistent" asp-route-Suchtyp="typ">Ja, ich möchte nach einem Leistungstyp suchen</a>
        </div>
    </div>
}
else if (string.Equals(Model.Suchtyp, "typ", StringComparison.OrdinalIgnoreCase) && !Model.Alter.HasValue)
{
    <div class="kern-card" style="padding:16px; margin-bottom:16px">
        <h2>Wie alt sind Sie zum Zeitpunkt, zu dem Sie die Leistung in Anspruch nehmen möchten?</h2>
        <div style="display:flex; gap:8px; margin-top:12px">
            <a class="kern-button kern-button--primary" asp-page="/SuchAssistent" asp-route-Suchtyp="typ" asp-route-Alter="1">Unter 18 Jahre</a>
            <a class="kern-button kern-button--primary" asp-page="/SuchAssistent" asp-route-Suchtyp="typ" asp-route-Alter="0">Über 18 Jahre</a>
        </div>
    </div>
}
else if (string.IsNullOrWhiteSpace(Model.Kategorie) && Model.Assistant is not null)
{
    <div class="kern-card" style="padding:16px; margin-bottom:16px">
        <h2>Womit benötigen Sie Unterstützung?</h2>
        <ul role="list" style="list-style:none; padding:0; margin:12px 0 0">
            @foreach (var category in Model.Assistant.Categories)
            {
                <li style="margin-bottom:8px">
                    <a class="kern-button kern-button--tertiary" style="width:100%; justify-content:flex-start"
                       asp-page="/SuchAssistent"
                       asp-route-Suchtyp="@Model.Suchtyp"
                       asp-route-Alter="@Model.Alter"
                       asp-route-Kategorie="@category.Name">@category.Name</a>
                </li>
            }
        </ul>
    </div>
}
else if (Model.Assistant is not null && Model.Leistung.HasValue && !Model.BeschreibungBestaetigt)
{
    <div class="kern-card" style="padding:16px; margin-bottom:16px">
        <h2>Beschreibung der Leistung</h2>
        @if (!string.IsNullOrWhiteSpace(Model.Leistungsbeschreibung))
        {
            <div class="kern-alert kern-alert--info" style="margin:12px 0">
                <div class="kern-alert__body">@Model.Leistungsbeschreibung</div>
            </div>
        }
        <a class="kern-button kern-button--primary"
           asp-page="/SuchAssistent"
           asp-route-Suchtyp="@Model.Suchtyp"
           asp-route-Alter="@Model.Alter"
           asp-route-Kategorie="@Model.Kategorie"
           asp-route-Leistung="@Model.Leistung"
           asp-route-BeschreibungBestaetigt="true">Weiter</a>
    </div>
}
else if (Model.Assistant is not null)
{
    <div class="kern-card" style="padding:16px; margin-bottom:16px">
        <h2>Welche Leistung benötigen Sie?</h2>
        <p><span class="kern-badge">Kategorie: @Model.Kategorie</span></p>
        <ul role="list" style="list-style:none; padding:0; margin:12px 0 0">
            @foreach (var leistung in Model.Assistant.Leistungen)
            {
                <li style="margin-bottom:8px">
                    <a class="kern-button kern-button--tertiary" style="width:100%; justify-content:flex-start"
                       asp-page="/SuchAssistent"
                       asp-route-Suchtyp="@Model.Suchtyp"
                       asp-route-Alter="@Model.Alter"
                       asp-route-Kategorie="@Model.Kategorie"
                       asp-route-Leistung="@leistung.Id">@leistung.Name</a>
                </li>
            }
        </ul>
    </div>

    @if (Model.Leistung.HasValue)
    {
        <h2 style="margin-top:24px">Wo möchten Sie die Leistung in Anspruch nehmen?</h2>

        <div style="display:flex; flex-wrap:wrap; gap:16px; margin-top:12px">
            <!-- PLZ Suche -->
            <form method="get" class="kern-card" style="flex:1; min-width:280px; padding:16px">
                <h3>Suche per Postleitzahl</h3>
                <input type="hidden" name="Suchtyp" value="@Model.Suchtyp" />
                <input type="hidden" name="Alter" value="@Model.Alter" />
                <input type="hidden" name="Kategorie" value="@Model.Kategorie" />
                <input type="hidden" name="Leistung" value="@Model.Leistung" />
                <input type="hidden" name="BeschreibungBestaetigt" value="true" />

                <div style="margin:12px 0">
                    <label class="kern-label" for="Postleitzahl">Postleitzahl</label>
                    <input class="kern-input-text" id="Postleitzahl" name="Postleitzahl" value="@Model.Postleitzahl" maxlength="5" inputmode="numeric" list="postal-code-options" autocomplete="off" style="width:100%; margin-top:4px" />
                    @if (Model.Postleitzahlen.Count > 0)
                    {
                        <datalist id="postal-code-options">
                            @foreach (var postalCode in Model.Postleitzahlen)
                            {
                                <option value="@postalCode"></option>
                            }
                        </datalist>
                    }
                </div>
                <button class="kern-button kern-button--primary" type="submit">Postleitzahl suchen</button>
            </form>

            <!-- Geo Suche - IDs must stay exact for suchassistent.js -->
            <form method="get" id="GeolocationForm" class="kern-card" style="flex:1; min-width:280px; padding:16px">
                <h3>Suche per Standort</h3>
                <input type="hidden" name="Suchtyp" value="@Model.Suchtyp" />
                <input type="hidden" name="Alter" value="@Model.Alter" />
                <input type="hidden" name="Kategorie" value="@Model.Kategorie" />
                <input type="hidden" name="Leistung" value="@Model.Leistung" />
                <input type="hidden" name="BeschreibungBestaetigt" value="true" />

                <div style="margin:12px 0">
                    <label class="kern-label" for="Latitude">Latitude</label>
                    <input class="kern-input-text" id="Latitude" name="Latitude" value="@Model.Latitude" type="number" step="any" required style="width:100%; margin-top:4px" />
                </div>
                <div style="margin:12px 0">
                    <label class="kern-label" for="Longitude">Longitude</label>
                    <input class="kern-input-text" id="Longitude" name="Longitude" value="@Model.Longitude" type="number" step="any" required style="width:100%; margin-top:4px" />
                </div>
                <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:12px">
                    <button class="kern-button kern-button--secondary" type="button" id="GeolocationSearchButton">Meinen Standort verwenden</button>
                    <button class="kern-button kern-button--primary" type="submit">Koordinaten suchen</button>
                </div>
                <p id="GeolocationMessage" role="status" aria-live="polite" style="margin-top:8px; font-size:0.875rem"></p>
            </form>
        </div>

        @if (Model.Kreise.Count > 0)
        {
            <div class="kern-card" style="padding:16px; margin-top:16px">
                <h3>Oder wählen Sie einen Kreis</h3>
                <ul role="list" style="list-style:none; padding:0; margin:12px 0 0; display:flex; flex-wrap:wrap; gap:8px">
                    @foreach (var kreis in Model.Kreise)
                    {
                        <li><a class="kern-button kern-button--tertiary" asp-page="/SuchAssistent" asp-route-Suchtyp="@Model.Suchtyp" asp-route-Alter="@Model.Alter" asp-route-Kategorie="@Model.Kategorie" asp-route-Leistung="@Model.Leistung" asp-route-BeschreibungBestaetigt="true" asp-route-Kreis="@kreis.Id">@kreis.Name</a></li>
                    }
                </ul>
            </div>
        }

        @if (Model.Kreis.HasValue || Model.Ergebnisse.Count > 0)
        {
            <div class="kern-card" style="padding:16px; margin-top:16px">
                <h3>Gefundene Einrichtungen</h3>
                @if (Model.Ergebnisse.Count == 0)
                {
                    <div class="kern-alert kern-alert--warning" style="margin-top:12px">
                        <div class="kern-alert__body">Für die gewählte Kombination wurden keine Einrichtungen gefunden.</div>
                    </div>
                }
                else
                {
                    <ul role="list" style="list-style:none; padding:0; margin:12px 0 0">
                        @foreach (var ergebnis in Model.Ergebnisse)
                        {
                            <li class="kern-card" style="padding:12px; margin-bottom:8px">
                                <h4 style="margin:0 0 4px"><a asp-page="/Stammdaten" asp-route-EIID="@ergebnis.EIID" asp-route-STUID="@ergebnis.STUID">@ergebnis.Name</a></h4>
                                @if (!string.IsNullOrWhiteSpace(ergebnis.Standortname))
                                {
                                    <div>@ergebnis.Standortname</div>
                                }
                                <div style="font-size:0.875rem; opacity:0.8">
                                    @ergebnis.Strasse @ergebnis.Hausnummer @ergebnis.Hausnummerzusatz<br />
                                    @ergebnis.PLZ @ergebnis.Ort
                                </div>
                                @if (!string.IsNullOrWhiteSpace(ergebnis.Telefon))
                                {
                                    <div style="margin-top:4px">Telefon: <a href="tel:@ergebnis.Telefon">@ergebnis.Telefon</a></div>
                                }
                                @if (ergebnis.Entfernung.HasValue)
                                {
                                    <span class="kern-badge" style="margin-top:8px">@ergebnis.Entfernung.Value.ToString("0.0") km</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        }
    }
}

@section Scripts {
    <script src="~/js/suchassistent.js" asp-append-version="true"></script>
}
@page
@model TOPqwWeb_Core.Pages.PasswordRequestModel
@{
    ViewData["Title"] = "Passwort zurücksetzen";
}

<h1>Passwort zurücksetzen</h1>

@if (!Model.IsValidToken)
{
    <p role="alert">@Model.ErrorMessage</p>
}
else
{
    <div class="PasswordPolicyHint">@Html.Raw(Model.PasswordPolicy.GetHint())</div>
    <form method="post">
        <div asp-validation-summary="ModelOnly"></div>
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <p role="alert">@Model.ErrorMessage</p>
        }
        <label asp-for="Input.Passwort"></label>
        <input asp-for="Input.Passwort" type="password" />
        <label asp-for="Input.PasswortBestaetigung"></label>
        <input asp-for="Input.PasswortBestaetigung" type="password" />
        <button type="submit">Passwort ändern</button>
    </form>
}

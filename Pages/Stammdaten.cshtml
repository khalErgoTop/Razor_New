@page
@model TOPqwWeb_Core.Pages.StammdatenModel
@{
    ViewData["Title"] = Model.Facility?.Name ?? "Stammdaten";
}

<nav aria-label="Brotkrümelnavigation">
    <ol class="breadcrumb">
        <li><a asp-page="/Index">Start</a></li>
        <li><a asp-page="/Sucharten">Leistungsangebote</a></li>
        <li aria-current="page">Stammdaten</li>
    </ol>
</nav>

@if (Model.Facility is not null)
{
    <article class="stammdaten">
        <h1>@Model.Facility.Name</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Facility.ImageFileName))
        {
            <p><img src="?handler=Image&amp;eiid=@Model.Facility.EIID" alt="Bild von @Model.Facility.Name" /></p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Facility.FacilityIndicator))
        {
            <p><strong>Einrichtungskennzeichen:</strong> @Model.Facility.FacilityIndicator</p>
        }

        @if (Model.Facility.Attachments.Count > 0)
        {
            <section>
                <h2>Anhänge</h2>
                <ul>
                    @foreach (var attachment in Model.Facility.Attachments)
                    {
                        <li>
                            <a asp-page-handler="Attachment"
                               asp-route-eiid="@Model.Facility.EIID"
                               asp-route-attachmentId="@attachment.Id">@attachment.Filename</a>
                        </li>
                    }
                </ul>
                <p>Die angehängten Dateien werden ohne Gewähr für Inhalt und Richtigkeit bereitgestellt.</p>
            </section>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Facility.Address))
        {
            <p><strong>Adresse:</strong> @Model.Facility.Address</p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Facility.Description))
        {
            <section>
                <h2>Beschreibung</h2>
                <div>@Html.Raw(Model.Facility.Description)</div>
            </section>
        }
        @if (Model.Facility.Contacts.Count > 0)
        {
            <section>
                <h2>Kontakt</h2>
                <dl>
                    @foreach (var contact in Model.Facility.Contacts)
                    {
                        <dt>@contact.Label</dt>
                        <dd>@contact.Value</dd>
                    }
                </dl>
            </section>
        }

        @if (Model.Facility.Locations.Count > 0)
        {
            <section>
                <h2>Standorte</h2>
                <ul>
                    @foreach (var location in Model.Facility.Locations)
                    {
                        <li>
                            @if (!string.IsNullOrWhiteSpace(location.Name))
                            {
                                <h3>@location.Name@(location.IsMainLocation ? " (Hauptstandort)" : string.Empty)</h3>
                            }
                            @if (!string.IsNullOrWhiteSpace(location.Address))
                            {
                                <p>Adresse: @location.Address</p>
                            }
                            @if (location.Contacts.Count > 0)
                            {
                                <dl>
                                    @foreach (var contact in location.Contacts)
                                    {
                                        <dt>@contact.Label</dt>
                                        <dd>@contact.Value</dd>
                                    }
                                </dl>
                            }
                        </li>
                    }
                </ul>
            </section>
        }
    </article>
}

@page
@model TOPqwWeb_Core.Pages.SuchartenModel
@{
    ViewData["Title"] = "Leistungsangebote";
}

<nav class="kern-breadcrumbs sucharten-breadcrumbs" aria-label="Brotkrümelnavigation">
    <ol class="breadcrumb">
        <li><a class="kern-link" asp-page="/Index"><span class="kern-icon kern-icon--home" aria-hidden="true"></span> Start</a></li>
        <li aria-current="page">Leistungsangebote</li>
    </ol>
</nav>

<main class="sucharten-page kern-stack">
    <section class="kern-card kern-card--large sucharten-card" aria-labelledby="sucharten-title">
        <div class="kern-card__container">
            <div class="kern-card__header">
                <h1 id="sucharten-title" class="kern-title">Leistungsangebote</h1>
                <p class="kern-body">Wählen Sie eine Suchart:</p>
            </div>

            <ul class="search-type-links" role="list">
                <li>
                    <a asp-page="/Suche" class="kern-card kern-card--interactive search-type-link">
                        <div class="kern-card__container">
                            <span class="search-type-link__icon kern-icon kern-icon--search" aria-hidden="true"></span>
                            <div class="search-type-link__content">
                                <span class="kern-title">Detailsuche</span>
                                <span class="kern-body">Gezielt nach Leistungen, Region und Stichworten filtern</span>
                            </div>
                        </div>
                    </a>
                </li>
                <li>
                    <a asp-page="/Auflistung" asp-route-Typ="Typ" class="kern-card kern-card--interactive search-type-link">
                        <div class="kern-card__container">
                            <span class="search-type-link__icon kern-icon kern-icon--category" aria-hidden="true"></span>
                            <div class="search-type-link__content">
                                <span class="kern-title">Nach Art der Leistung</span>
                                <span class="kern-body">Assistenz, Wohnen, Tagesförderung, WfbM u.a.</span>
                            </div>
                        </div>
                    </a>
                </li>
                <li>
                    <a asp-page="/Auflistung" asp-route-Typ="Kreis" class="kern-card kern-card--interactive search-type-link">
                        <div class="kern-card__container">
                            <span class="search-type-link__icon kern-icon kern-icon--location" aria-hidden="true"></span>
                            <div class="search-type-link__content">
                                <span class="kern-title">Nach @Model.DistrictLabel</span>
                                <span class="kern-body">Angebote in Ihrer Nähe finden</span>
                            </div>
                        </div>
                    </a>
                </li>
            </ul>
        </div>
    </section>
</main>

<style>
    .sucharten-page {
        max-width: var(--kern-480);
        margin: var(--kern-metric-space-6x-large) auto;
        padding: 0 var(--kern-metric-space-default);
    }

    .sucharten-card .kern-card__header {
        gap: var(--kern-metric-space-x-small);
    }

    .sucharten-card .kern-title,
    .sucharten-card .kern-body,
    .search-type-link .kern-title,
    .search-type-link .kern-body {
        margin: 0;
    }

    .search-type-links {
        display: flex;
        flex-direction: column;
        gap: var(--kern-metric-space-small);
        list-style: none;
        margin: var(--kern-metric-space-large) 0 0;
        padding: 0;
    }

    .search-type-link {
        color: var(--kern-color-layout-text-default);
        text-decoration: none;
    }

    .search-type-link .kern-card__container {
        display: flex;
        align-items: center;
        gap: var(--kern-metric-space-default);
    }

    .search-type-link__icon {
        flex: 0 0 auto;
        font-size: var(--kern-24, 1.5rem);
    }

    .search-type-link__content {
        display: flex;
        flex-direction: column;
        gap: var(--kern-metric-space-2x-small);
    }

    .search-type-link:hover,
    .search-type-link:focus-visible {
        border-color: var(--kern-color-action-default);
    }

    .search-type-link:focus-visible {
        outline: var(--kern-metric-border-width-light) solid var(--kern-color-action-focus-default);
        outline-offset: var(--kern-metric-space-2x-small);
    }
</style>

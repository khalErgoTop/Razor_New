@inject TOPqwWeb_Core.Infrastructure.Theming.ThemeAssetService ThemeAssets
@inject TOPqwWeb_Core.Infrastructure.Security.CurrentUserAccessor CurrentUser
@{
    var themeName = ThemeAssets.ThemeName;
    var usesKern = ThemeAssets.UsesKern;
    // Das freigegebene Verwaltungsseitenlayout benötigt weiterhin seine bisherige KERN-Basis.
    var preserveKernLayout = ViewData["PreserveKernLayout"] is true;
    var loadKern = usesKern || preserveKernLayout;
    var logo = themeName.ToUpperInvariant() switch
    {
        "HH" => ("~/css/HH/Images/hamburg-de-logo.png", "Hamburg"),
        "SH" => ("~/css/SH/Images/Logo_Schleswig-Holstein.svg", "Schleswig-Holstein"),
        "BE" => ("~/css/BE/Images/logo_berlin_m_srgb.svg", "Berlin"),
        "HB-WBA" => ("~/css/HB-WBA/Images/bremen_logo_schwarz.svg", "Bremen"),
        "MV" => ("~/css/MV/Images/Logo.png", "Mecklenburg-Vorpommern"),
        "NI" => ("~/css/NI/images/niedersachsen.png", "Niedersachsen"),
        "ST" => ("~/css/ST/Images/Logo.png", "Sachsen-Anhalt"),
        "TH" => ("~/css/TH/logo_thueringen.gif", "Thüringen"),
        _ => ((string?)null, "TOPqwWeb")
    };
}
<!DOCTYPE html>
<html lang="de" data-theme="@themeName" data-design="@(usesKern ? "kern" : "legacy")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TOPqwWeb</title>

    @if (loadKern)
    {
        <link rel="stylesheet" href="~/lib/kern/kern.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/lib/kern/fonts/fira-sans.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @if (!usesKern)
    {
        @foreach (var file in new[] { "QW_ContrastNormal.css", "theme.css", "menu.css" })
        {
            var asset = ThemeAssets.GetExistingLegacyAssetPath(file);
            if (asset is not null)
            {
                <link rel="stylesheet" href="@Url.Content(asset)" asp-append-version="true" />
            }
        }
        @if (preserveKernLayout || ViewData["LegacyListingStyles"] is true)
        {
            var listingAsset = ThemeAssets.GetExistingLegacyAssetPath("auflistung.css");
            if (listingAsset is not null)
            {
                <link rel="stylesheet" href="@Url.Content(listingAsset)" asp-append-version="true" />
            }
        }
        <link rel="stylesheet" href="~/css/legacy-compat.css" asp-append-version="true" />
        @if (!preserveKernLayout)
        {
            <link rel="stylesheet" href="~/css/legacy-razor.css" asp-append-version="true" />
        }
    }
</head>
<body class="@(loadKern ? "kern-level-0" : null)">

    <div id="Page" style="max-width: 1280px; margin: 0 auto; padding: 0 16px;">
        <header class="site-header">
            <div class="site-brand">
                <a class="site-brand__home" asp-page="/Index" accesskey="0" aria-label="Startseite">
                    @if (logo.Item1 is not null)
                    {
                        <img src="@Url.Content(logo.Item1)" alt="@logo.Item2" />
                    }
                    else
                    {
                        <span>TOPqwWeb</span>
                    }
                </a>
                <span class="site-brand__title">@ViewData["Title"]</span>
            </div>

            <div class="site-header__actions">
                @if (CurrentUser.IsAuthenticated)
                {
                    <span class="kern-badge">@CurrentUser.Username</span>
                    <a class="kern-button kern-button--secondary" asp-page="/Logout">Abmelden</a>
                }
                else
                {
                    <a class="kern-button kern-button--primary" asp-page="/Login">Anmelden</a>
                }
                <button class="kern-button kern-button--tertiary" data-layout-action="contrast" aria-pressed="false">
                    <span class="kern-icon kern-icon--brightness-medium" aria-hidden="true"></span> Kontrast
                </button>
            </div>
        </header>

        <partial name="_Navigation" />

        <main role="main" class="site-main">
            @RenderBody()
        </main>

        <partial name="_Footer" />
    </div>

    <!-- Web Component nur 1x als module -->
    @if (usesKern)
    {
        <script type="module" src="~/lib/kern/js/kern-kopfzeile.js" asp-append-version="true"></script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
            document.querySelector('[data-layout-action="contrast"]')?.addEventListener('click', function (event) {
                event.preventDefault();
                document.documentElement.classList.toggle('high-contrast');
                this.setAttribute('aria-pressed', document.documentElement.classList.contains('high-contrast').toString());
            });
    </script>

    <style>
        .site-header {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 16px 0;
            border-bottom: 1px solid var(--kern-color-layout-border);
        }

        .site-brand,
        .site-header__actions {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .site-brand__home {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            color: inherit;
            font-size: 1.35rem;
            font-weight: 700;
            text-decoration: none;
        }

        .site-brand__home img {
            display: block;
            width: auto;
            height: 48px;
        }

        .site-brand__title {
            opacity: .7;
        }

        .site-main {
            padding: 24px 0;
        }

        .site-header__actions {
            flex-wrap: wrap;
        }
    </style>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
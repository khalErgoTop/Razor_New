@page
@model TOPqwWeb_Core.Pages.PasswortAendernModel
@{
    ViewData["Title"] = "Passwort ändern";
}

<nav class="kern-breadcrumbs" aria-label="Brotkrümelnavigation">
    <ol class="breadcrumb">
        <li><a class="kern-link" asp-page="/Index">Start</a></li>
        <li><a class="kern-link" asp-page="/Auth/QWWebAdmin">Administration</a></li>
        <li aria-current="page">Passwort ändern</li>
    </ol>
</nav>

<section class="pageContent kern-stack">
    <h1 class="kern-heading-1">Passwort ändern</h1>
    <div class="box kern-card" style="padding:16px">
        <div class="password-info kern-alert kern-alert--info"><div class="kern-alert__body">@Html.Raw(Model.PasswordPolicy.GetHint())</div></div>
        <form method="post" class="kern-stack">
            @if (Model.IsAdministrativeChange)
            {
                <input type="hidden" asp-for="UserId" />
            }
            <fieldset>
                <legend>@(Model.IsAdministrativeChange ? $"Passwort ändern für: {Model.TargetUsername}" : "Eigenes Passwort ändern")</legend>
                @if (!Model.IsAdministrativeChange)
                {
                    <div>
                        <label asp-for="Input.AltesPasswort">Altes Passwort</label>
                        <input class="kern-form-input__input" asp-for="Input.AltesPasswort" type="password" autocomplete="current-password" />
                    </div>
                }
                <div>
                    <label asp-for="Input.NeuesPasswort">Neues Passwort</label>
                        <input class="kern-form-input__input" asp-for="Input.NeuesPasswort" type="password" autocomplete="new-password" />
                </div>
                <div>
                    <label asp-for="Input.PasswortBestaetigung">Passwort bestätigen</label>
                        <input class="kern-form-input__input" asp-for="Input.PasswortBestaetigung" type="password" autocomplete="new-password" />
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Message))
                {
                    <div class="kern-alert @(Model.IsSuccess ? "kern-alert--success" : "kern-alert--error")"><div class="kern-alert__body">@Model.Message</div></div>
                }
                <button class="kern-button kern-button--primary" type="submit" asp-page-handler="@(Model.IsAdministrativeChange ? "Administrative" : null)">Speichern</button>
                <button class="kern-button kern-button--secondary" type="submit" asp-page-handler="Cancel" formnovalidate>Abbrechen</button>
            </fieldset>
        </form>
    </div>
</section>

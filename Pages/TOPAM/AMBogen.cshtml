@page
@model TOPqwWeb_Core.Pages.AM.AMBogenModel
@{
    ViewData["Title"] = "Anbietermanagement";
    var editableCount = Model.Category?.Subcategories.Sum(group => group.Items.Count(item => item.Editable)) ?? 0;
}
<link rel="stylesheet" href="~/css/ambogen-modern.css" asp-append-version="true" />

<div class="am-page" data-am-page>
    <nav class="am-breadcrumb" aria-label="Brotkrümelnavigation"><a asp-page="/Index">Start</a><span aria-hidden="true"> / </span><span aria-current="page">Anbietermanagement</span></nav>
    <header class="am-header">
        <p class="am-eyebrow">Anbietermanagement</p>
        <h1>AM-Bogen</h1>
        <p>Wählen Sie einen Standort und einen Bereich, um die Angaben einzusehen.</p>
    </header>
    @if (Model.SaveMessage is not null) { <div class="am-notice" role="status">@Model.SaveMessage</div> }
    @if (Model.ErrorMessage is not null) { <div class="am-notice am-notice--error" role="alert">@Model.ErrorMessage</div> }
    @if (Model.SelectedFacility is null)
    {
        <section class="am-empty"><h2>Keine Standorte verfügbar</h2><p>Für Ihr Benutzerkonto stehen keine Standorte zur Auswahl.</p></section>
    }
    else
    {
        <section class="am-sites" aria-labelledby="am-sites-title">
            <div class="am-section-heading"><div><h2 id="am-sites-title">Ausgewählter Standort</h2><p>@Model.SelectedFacility.Name · @Model.SelectedFacility.Indicator · @Model.SelectedFacility.LocationName</p></div></div>
            <details class="am-site-search" open="@(Model.Search is not null ? "open" : null)">
                <summary>Anderen Standort suchen</summary>
                <form method="get" asp-page="/TOPAM/AMBogen">
                    <input type="hidden" name="EIID" value="@Model.EIID" />
                    <input type="hidden" name="STUID" value="@Model.STUID" />
                    @if (Model.OID.HasValue) { <input type="hidden" name="OID" value="@Model.OID" /> }
                    <label for="am-site-filter">Name, Kennzeichen oder Standortname</label>
                    <div class="am-search-controls"><input id="am-site-filter" class="am-filter" type="search" name="Search" value="@Model.Search" minlength="2" maxlength="100" required aria-describedby="am-search-hint" /><button class="am-button" type="submit">Suchen</button></div>
                    <p id="am-search-hint" class="am-muted">Mindestens zwei Zeichen eingeben.</p>
                </form>
                @if (Model.SearchMessage is not null) { <p role="status">@Model.SearchMessage</p> }
                @if (Model.Facilities.Count > 0)
                {
                    <p role="status">@Model.Facilities.Count Treffer@(Model.MoreFacilities ? " (weitere Treffer vorhanden; bitte Suche verfeinern)" : "")</p>
                    <ul class="am-site-list">
                        @foreach (var facility in Model.Facilities)
                        {
                            var selected = facility.EIID == Model.SelectedFacility.EIID && facility.STUID == Model.SelectedFacility.STUID;
                            <li>
                                <a asp-page="/TOPAM/AMBogen" asp-route-EIID="@facility.EIID" asp-route-STUID="@facility.STUID" class="am-site @(selected ? "am-site--selected" : null)" aria-current="@(selected ? "true" : null)">
                                    <strong>@facility.Name</strong><span>@facility.Indicator</span><span>@facility.LocationName</span>
                                    @if (selected) { <span class="am-site__selected">Ausgewählt</span> }
                                </a>
                            </li>
                        }
                    </ul>
                }
            </details>
        </section>
        @if (Model.SelectedFacility is not null)
        {
            <div class="am-workspace">
                <aside class="am-sidebar"><h2>Bereiche</h2>
                    <nav aria-label="Bereiche des AM-Bogens"><ul>
                    @foreach (var category in Model.Categories)
                    {
                        <li><a asp-page="/TOPAM/AMBogen" asp-route-EIID="@Model.EIID" asp-route-STUID="@Model.STUID" asp-route-OID="@category.Id" class="@(category.Id == Model.OID ? "am-category--selected" : null)" aria-current="@(category.Id == Model.OID ? "page" : null)">@category.Name</a></li>
                    }
                    </ul></nav>
                </aside>
                <div class="am-content">
                    @if (Model.Category is null)
                    {
                        <section class="am-empty"><h2>Keine Bereiche verfügbar</h2><p>Für diesen Bogen wurden keine Bereiche gefunden.</p></section>
                    }
                    else
                    {
                        <header class="am-content__header"><p class="am-eyebrow">Ausgewählter Bereich</p><h2>@Model.Category.Name</h2><p>@Model.SelectedFacility.Name · @Model.SelectedFacility.LocationName</p></header>
                        @if (!Model.CanEdit) { <div class="am-notice">Sie können diesen Bogen ansehen, aber nicht bearbeiten.</div> }
                        @if (Model.Category.Subcategories.Count == 0) { <section class="am-empty"><p>In diesem Bereich sind keine Angaben hinterlegt.</p></section> }
                        <form method="post" asp-page-handler="Save" data-am-form data-am-unsaved="@(Model.ErrorMessage is not null ? "true" : "false")">
                            <input type="hidden" name="eiid" value="@Model.EIID" />
                            <input type="hidden" name="stuid" value="@Model.STUID" />
                            <input type="hidden" name="oid" value="@Model.OID" />
                            @foreach (var group in Model.Category.Subcategories)
                            {
                                <details class="am-group" open>
                                    <summary>@group.Name</summary>
                                    <div class="am-group__body">
                                    @foreach (var item in group.Items)
                                    {
                                        var value = Model.Values.TryGetValue(item.Id, out var posted) ? posted ?? "" : item.Value;
                                        var fieldId = $"am-item-{item.Id}";
                                        <div class="am-field">
                                            @if (item.IsSelection)
                                            {
                                                var selectedOptions = item.Options.Where(option => option.Selected).ToArray();
                                                <fieldset class="am-selection">
                                                    <legend>@item.Name</legend>
                                                    @if (item.Options.Count == 0)
                                                    {
                                                        <p class="am-muted">Keine Auswahlmöglichkeiten hinterlegt.</p>
                                                    }
                                                    else if (!Model.CanEdit || !item.Editable)
                                                    {
                                                        @if (selectedOptions.Length == 0) { <p class="am-value">Keine Auswahl</p> }
                                                        else { <ul class="am-selection__values">@foreach (var option in selectedOptions) { <li>@option.Name</li> }</ul> }
                                                        @if (!item.Editable) { <p class="am-muted">Diese Auswahl kann hier nicht bearbeitet werden.</p> }
                                                    }
                                                    else
                                                    {
                                                        @foreach (var option in item.Options)
                                                        {
                                                            <input type="hidden" name="OriginalSelections[@option.Id]" value="@(Model.OriginalSelections.TryGetValue(option.Id, out var originalSelection) ? originalSelection : option.Selected ? "1" : "0")" />
                                                        }
                                                        @if (item.IsSingleSelection)
                                                        {
                                                            var choice = Model.SingleSelections.TryGetValue(item.Id, out var postedChoice) ? postedChoice ?? "" : selectedOptions.Length > 1 ? "__multiple" : selectedOptions.FirstOrDefault()?.Id.ToString() ?? "";
                                                            <label for="@fieldId">Auswahl</label>
                                                            <select class="am-input" id="@fieldId" name="SingleSelections[@item.Id]">
                                                                @if (choice == "__multiple") { <option value="__multiple" selected>Mehrere vorhandene Auswahlen – bitte prüfen</option> }
                                                                <option value="" selected="@(choice == "")">Keine Auswahl</option>
                                                                @foreach (var option in item.Options) { <option value="@option.Id" selected="@(choice == option.Id.ToString())">@option.Name</option> }
                                                            </select>
                                                            @if (choice == "__multiple") { <p class="am-muted">Bisher ausgewählt: @string.Join(", ", selectedOptions.Select(option => option.Name))</p> }
                                                        }
                                                        else
                                                        {
                                                            <div class="am-selection__options">
                                                                @foreach (var option in item.Options)
                                                                {
                                                                    var isSelected = Model.Selections.TryGetValue(option.Id, out var postedSelection) ? postedSelection == "1" : option.Selected;
                                                                    var optionId = $"am-option-{option.Id}";
                                                                    <div class="am-selection__option"><input type="checkbox" id="@optionId" name="Selections[@option.Id]" value="1" checked="@isSelected" /><input type="hidden" name="Selections[@option.Id]" value="0" /><label for="@optionId">@option.Name</label></div>
                                                                }
                                                            </div>
                                                        }
                                                    }
                                                </fieldset>
                                            }
                                            else if (!item.Editable)
                                            {
                                                <strong>@item.Name</strong>
                                                @if (item.DisplayTypeCode == 12)
                                                {
                                                    <p class="am-value">@(string.IsNullOrEmpty(value) ? "Keine Angabe" : value)</p><p class="am-muted">Diese Zeitangabe kann hier nicht bearbeitet werden.</p>
                                                }
                                                else
                                                {
                                                    <p class="am-muted">Diese Angabe (@item.DisplayType) wird hier noch nicht unterstützt.</p>
                                                }
                                            }
                                            else if (!Model.CanEdit)
                                            {
                                                <strong>@item.Name</strong><p class="am-value">@(item.DisplayTypeCode is 1 or 3 ? (value == "1" ? "Ja" : value == "0" ? "Nein" : "Keine Angabe") : (string.IsNullOrEmpty(value) ? "Keine Angabe" : value))</p>
                                            }
                                            else
                                            {
                                                <input type="hidden" name="OriginalValues[@item.Id]" value="@(Model.OriginalValues.TryGetValue(item.Id, out var original) ? original : "v" + Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(item.Value)))" />
                                                <label for="@fieldId">@item.Name</label>
                                                @if (item.DisplayTypeCode is 1 or 3)
                                                {
                                                    <select class="am-input" id="@fieldId" name="Values[@item.Id]"><option value="" selected="@(value == "")">Keine Angabe</option><option value="1" selected="@(value == "1")">Ja</option><option value="0" selected="@(value == "0")">Nein</option></select>
                                                }
                                                else if (item.DisplayTypeCode == 8)
                                                {
                                                    <input class="am-input" id="@fieldId" type="number" step="1" name="Values[@item.Id]" value="@value" />
                                                }
                                                else if (item.DisplayTypeCode == 12)
                                                {
                                                    @if (TOPqwWeb_Core.Services.Modules.AnbieterManagementService.IsValidTime(value))
                                                    {
                                                        <input class="am-input" id="@fieldId" type="time" step="any" name="Values[@item.Id]" value="@value" />
                                                    }
                                                    else
                                                    {
                                                        <textarea class="am-input" id="@fieldId" name="Values[@item.Id]" rows="2" aria-describedby="@(fieldId)-time-hint">@value</textarea>
                                                        <p class="am-muted" id="@(fieldId)-time-hint">Der vorhandene Wert ist keine gültige Uhrzeit. Bei einer Änderung bitte eine Uhrzeit im Format HH:MM eingeben.</p>
                                                    }
                                                }
                                                else if (item.DisplayTypeCode == 14)
                                                {
                                                    <input class="am-input" id="@fieldId" type="number" step="any" name="Values[@item.Id]" value="@value" />
                                                }
                                                else
                                                {
                                                    <textarea class="am-input" id="@fieldId" name="Values[@item.Id]" rows="3">@value</textarea>
                                                }
                                            }
                                        </div>
                                    }
                                    </div>
                                </details>
                            }
                            @if (Model.CanEdit && editableCount > 0) { <div class="am-savebar"><span>Änderungen für diesen Bereich speichern.</span><button type="submit" class="am-button">Speichern</button></div> }
                        </form>
                    }
                </div>
            </div>
        }
    }
</div>
<script src="~/js/ambogen-modern.js" asp-append-version="true" defer></script>

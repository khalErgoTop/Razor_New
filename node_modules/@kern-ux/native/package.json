{
  "name": "@kern-ux/native",
  "version": "2.7.2",
  "description": "Native Styles und Komponenten-Bibliothek für das KERN-UX Design System. Beinhaltet CSS, Fonts und KERN-Komponenten.",
  "author": "Kern-UX",
  "license": "EUPL-1.2",
  "type": "module",
  "homepage": "https://kern-ux.de",
  "bugs": {
    "url": "https://gitlab.opencode.de/kern-ux/kern-ux-plain/-/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.opencode.de/kern-ux/kern-ux-plain.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "contributors": [
    "Tom Marienfeld <tom.marienfeld@dataport.de>",
    "Darko Pervan <darko.pervan@dataport.de>",
    "Weitere Mitwirkende (https://gitlab.opencode.de/kern-ux/kern-ux-plain/-/graphs/main?ref_type=heads)"
  ],
  "style": "dist/kern.min.css",
  "sideEffects": false,
  "files": [
    "src",
    "dist/kern.css",
    "dist/kern.min.css",
    "dist/kern-grid.css",
    "dist/kern-grid.min.css",
    "dist/kern-utilities.css",
    "dist/kern-utilities.min.css",
    "dist/fonts/",
    "dist/js/kern-kopfzeile.js",
    "CHANGELOG.md"
  ],
  "keywords": [
    "kern-ux",
    "design-system",
    "native",
    "css-library",
    "dachmarke",
    "ux",
    "accessibility",
    "barrierefreiheit",
    "government",
    "public-administration",
    "open-source",
    "opencode",
    "html-css",
    "components"
  ],
  "scripts": {
    "start": "npm run dev",
    "dev": "npm-run-all --parallel scss:watch storybook",
    "storybook": "storybook dev -p 6006",
    "scss:watch": "vite build --watch --config vite.config.dev.js",
    "build": "vite build --config vite.config.prod.js && vite build --config vite.config.dev.js && storybook build",
    "test:visual": "node scripts/generate-backstop-config.js && npx backstop reference && npx backstop test",
    "test:a11y": "node scripts/a11y.js",
    "update-release-versions": "node scripts/update-all-release-versions.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/gitlab": "^13.2.5",
    "@semantic-release/npm": "^11.0.3",
    "@storybook/addon-a11y": "^9.0.10",
    "@storybook/addon-docs": "^9.0.10",
    "@storybook/addon-links": "^9.0.10",
    "@storybook/html-vite": "^9.0.10",
    "@types/node": "^22.7.5",
    "axe-core": "^4.10.3",
    "axe-html-reporter": "^2.2.11",
    "backstopjs": "^6.3.25",
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "npm-run-all": "^4.1.5",
    "puppeteer": "^24.10.1",
    "sass": "^1.94.1",
    "semantic-release": "^22.0.12",
    "storybook": "^9.0.10",
    "storybook-addon-pseudo-states": "^9.0.10"
  },
  "overrides": {
    "storybook": "$storybook",
    "backstopjs": {
      "puppeteer": "^24.10.1",
      "puppeteer-core": "^24.10.1"
    }
  }
}

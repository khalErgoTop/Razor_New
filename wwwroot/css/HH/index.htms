    #textToSpeechButton {
background-image: url(Images/speech.svg);
  filter: invert(11%) sepia(24%) saturate(6126%) hue-rotate(187deg) brightness(100%) contrast(101%);
  background-size: 100%;
  background-repeat: no-repeat;
  font-size: 0;
  height: 24px;
  width: 24px;
  top: 1rem;
  z-index: 1;
  left: 22rem
    }
